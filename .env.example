# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# Local development uses SQLite (no Docker required).
# On AWS this becomes a Postgres URL, e.g.
#   postgresql://user:pass@host:5432/socsim?schema=public
DATABASE_URL="file:./dev.db"

# --- Auth -------------------------------------------------------------------
# Sessions are signed JWTs in an httpOnly cookie.
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Server -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGIN="http://localhost:5173"

# Set to "true" behind HTTPS (required for Secure cookies in production).
COOKIE_SECURE=false
