// Local development runs on SQLite so the project needs no Docker.
//
// PORTABILITY: this schema deliberately avoids Prisma features that do not
// exist in SQLite (native enums, scalar lists). Statuses and roles are plain
// strings constrained by TypeScript unions in @soc/shared, and structured blobs
// are JSON-encoded strings. Moving to Postgres on AWS is therefore a change of
// `provider` + DATABASE_URL plus a fresh migration -- not a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  /// "student" | "instructor" | "admin" -- see UserRole in @soc/shared
  role         String    @default("student")
  /// "free" | "paid" -- see UserTier in @soc/shared. Free opens the whole
  /// learning platform and the war rooms; paid adds the career pack (the
  /// assessment, the portfolio, the simulation interview).
  tier         String    @default("free")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// How the floor addresses this person over the microphone. Nullable because
  /// it is chosen when somebody first takes a seat rather than at signup: the
  /// learning platform never needs it, and asking for one during registration
  /// is a question about a product the person has not seen yet.
  callSign     String?   @unique
  /// See AVATARS in @soc/shared. Plain string, not an enum, for Postgres
  /// portability.
  avatarId     String?

  progress         ExerciseProgress[]
  practiceProgress PracticeProgress[]
  terminalSessions TerminalSession[]
  attempts         AttemptLog[]
  copilotConsults  CopilotConsult[]
  scenarioAttempts ScenarioAttempt[]
  assessment       AssessmentSession?
  hostedRooms      RoomSession[]

  @@map("users")
}

/// One row per student per exercise. Created lazily on first attempt.
model ExerciseProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable content id such as "1.4.3". Not a foreign key: exercise content
  /// lives in version-controlled code, not in the database.
  exerciseId String
  /// Denormalised for cheap per-package aggregate queries.
  packageId  String
  moduleId   String

  /// "not_started" | "in_progress" | "passed" -- see ExerciseStatus
  status          String    @default("in_progress")
  attempts        Int       @default(0)
  completedAt     DateTime?
  lastAttemptedAt DateTime?

  /// How many hints the student has asked for, so the UI can restore the same
  /// state on reload rather than silently re-hiding help they already used.
  hintsRevealed Int @default(0)

  /// Whether the student asked to be shown the answer. Recorded so instructors
  /// can see where the material is too hard -- never used to penalise anyone.
  solutionRevealed Boolean @default(false)

  @@unique([userId, exerciseId])
  @@index([userId, packageId])
  @@map("exercise_progress")
}

/// Progress on optional practice drills.
///
/// Kept separate from ExerciseProgress on purpose: practice must never affect
/// unlocking or the completion percentage, and keeping it in its own table makes
/// that impossible to get wrong by accident.
model PracticeProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Parent exercise, e.g. "1.4.3".
  exerciseId String
  /// Drill id, e.g. "1.4.3-p2".
  practiceId String

  passed          Boolean   @default(false)
  attempts        Int       @default(0)
  completedAt     DateTime?
  lastAttemptedAt DateTime?

  @@unique([userId, practiceId])
  @@index([userId, exerciseId])
  @@map("practice_progress")
}

/// Live terminal state for one student working one exercise, so a student can
/// close the browser mid-exercise and pick up exactly where they left off.
model TerminalSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String

  /// Current working directory in the simulated filesystem.
  cwd String @default("/home/student")

  /// JSON-encoded overlay of the student's mutations against the immutable
  /// base filesystem image. Storing only the diff keeps rows small -- the
  /// seeded logs alone are hundreds of kilobytes.
  overlayJson String @default("{}")

  /// JSON-encoded scrollback so the terminal redraws on reload.
  scrollbackJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@map("terminal_sessions")
}

/// Append-only record of every attempt. Required for the instructor audit
/// trail, and it is what tells us which exercises students get stuck on.
model AttemptLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String
  /// Set when the attempt was against a practice drill rather than the exercise.
  practiceId String?
  /// Exactly what the student typed.
  input      String
  passed     Boolean
  /// JSON-encoded array of failed check types, for stuck-point analytics.
  failedJson String   @default("[]")
  createdAt  DateTime @default(now())

  @@index([userId, exerciseId])
  @@index([exerciseId, passed])
  @@map("attempt_logs")
}

/// A learner's answers to the Career Fit Analyzer.
///
/// One row per user: retaking replaces answers rather than accumulating history,
/// because a stale answer from three months ago should not quietly keep steering
/// somebody's recommendation. Individual dimensions can be retaken, which is why
/// responses are stored as a keyed blob rather than a fixed set of columns.
model AssessmentSession {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JSON: { [itemId]: { value?: number, optionId?: string } }
  /// A JSON string rather than a relation table because responses are only ever
  /// read and written as a whole set, and this schema must port to Postgres
  /// without scalar lists.
  responsesJson String @default("{}")

  /// JSON-encoded LearnerProfile: sector, org size, clearance, chosen track.
  profileJson String @default("{}")

  /// The generated report, cached so revisiting results does not rescore.
  /// Null until the learner submits for the first time.
  reportJson String?

  /// JSON: { [probeId]: optionId } for the capability baseline.
  /// Stored on the same row as the career assessment because the two are one
  /// journey -- "what do you want" then "what can you do" -- and separating them
  /// would mean two lookups on every dashboard render.
  probeResponsesJson String @default("{}")

  /// Which lane the baseline was taken against. Readiness is lane-specific: the
  /// same answers mean different things for SOC and for risk work.
  baselineLaneId String?

  /// Set when the learner has seen their report at least once.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("assessment_sessions")
}

/// One row per student per alert they opened the AI copilot on.
///
/// Recorded server-side when the analysis is served, never reported by the
/// client. "Did you consult the copilot before deciding" is graded, so a
/// client-supplied answer to it would be an answer the student controls -- the
/// same reasoning that keeps the terminal and the exercise checks on the server.
///
/// It doubles as the instructor audit trail: what the assistant was asked about,
/// by whom, and how often, which is what a debrief needs in order to say "it
/// suggested X and you found Y".
model CopilotConsult {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The exercise the queue was being worked for. Consultation is scoped to it
  /// so that re-reading an alert while working a later exercise cannot
  /// retroactively satisfy an earlier one's `copilot-consulted` check.
  exerciseId String
  /// Alert the analysis was requested for, e.g. "A-5006".
  alertId    String

  /// How many times it was opened. A student who re-reads one analysis five
  /// times was working at it, and that is worth an instructor seeing.
  views Int @default(1)

  createdAt    DateTime @default(now())
  lastViewedAt DateTime @updatedAt

  @@unique([userId, exerciseId, alertId])
  @@index([userId, exerciseId])
  @@map("copilot_consults")
}

/// One completed run of one scenario, at one tier, from one seat.
///
/// NOT UNIQUE ON (user, scenario, tier). Repeating is the intended progression:
/// the same incident at a harder tier is the whole point of the difficulty
/// design, and running it again from a different chair is different practice
/// because no seat sees the whole board. Every run is its own row, and the
/// picker derives its badges from the set.
model ScenarioAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Content id such as "cheap-rent". Not a foreign key: scenarios live in
  /// version-controlled code rather than in the database.
  scenarioId String
  /// "beginner" | "intermediate" | "advanced" | "expert" -- ScenarioDifficulty.
  difficulty String
  /// The seat they held, e.g. "forensics" -- see SocRoleId in @soc/shared.
  role       String

  /// Out of 100, across every event they claimed.
  score Int
  /// Whether this run reached the findings that decided the incident.
  /// Stored rather than derived because the answer key can be re-authored, and
  /// a student's history should not change when content does.
  caughtCritical Boolean @default(false)

  /// The room this was run in, so an instructor can reach the whole session.
  roomId String?

  completedAt DateTime @default(now())

  @@index([userId, scenarioId])
  @@index([userId, completedAt])
  @@map("scenario_attempts")
}

/// One adversarial match between two students: one attacks (red), one defends
/// (blue), turn for turn and asynchronously. See MatchState in @soc/shared.
///
/// WHY PLAYERS ARE PLAIN IDS, NOT RELATIONS
/// A match references two users but is owned by neither, the same call the
/// schema already makes for ScenarioAttempt.roomId. Storing red/blue/host as
/// bare id strings avoids threading two nullable back-relations through the
/// User model -- which two parallel sessions would both be editing -- and costs
/// only referential cascade, which a walked-away match row does not need.
///
/// WHY ONE JSON BLOB
/// The authoritative board (both sides' full move history and identities) is a
/// single JSON string, never read piecemeal and never sent whole to a client:
/// matchViewFor() redacts it per side. Only the fields the lobby and "my
/// matches" queries filter on are promoted to columns, and those are derived
/// from the blob on every write so they cannot drift from it.
model Match {
  id         String @id @default(uuid())
  scenarioId String
  /// ScenarioDifficulty
  difficulty String
  /// MatchStatus: "waiting" | "active" | "complete" | "abandoned"
  status     String @default("waiting")
  /// RoomVisibility: "open" (queue) | "closed" (invite code)
  visibility String

  /// Set for closed matches, null for open ones. Indexed for join-by-code.
  joinCode String?

  hostUserId String
  redUserId  String?
  blueUserId String?

  /// The full MatchState as JSON: identities, every move, turn cursor, clocks.
  /// Source of truth; the columns above are a queryable projection of it.
  stateJson String @default("{}")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastMoveAt DateTime?

  @@index([joinCode])
  @@index([status, visibility])
  @@index([redUserId])
  @@index([blueUserId])
  @@map("matches")
}

/// A scheduled war room: one scenario, run at one tier, at one start time.
///
/// The seat chart is built from the scenario's own declared roles and never
/// from the role catalogue, so a scenario that seats six has six chairs and a
/// seventh cannot be offered or taken. See the seating tests in
/// services/rooms.test.ts, which hold that for every scenario in the
/// catalogue.
model RoomSession {
  id         String   @id @default(uuid())
  scenarioId String
  /// "beginner" | "intermediate" | "advanced" | "expert" -- ScenarioDifficulty
  /// in @soc/shared. On the run, not the scenario: the same incident is worth
  /// playing at more than one tier.
  difficulty String
  startsAt   DateTime
  /// "open" | "closed" -- RoomVisibility in @soc/shared.
  visibility String
  /// Set for closed rooms and null for open ones. Stored rather than derived so
  /// a leaked code can be rotated without moving everybody to a new room.
  joinCode   String?
  /// "scheduled" | "running" | "complete" | "cancelled" -- RoomStatus.
  status     String   @default("scheduled")
  hostUserId String
  /// SeatAssignment[] as JSON. Seats are read and written as one unit and are
  /// never queried across rooms, so a table would buy nothing and cost a join
  /// on every seat change.
  seatsJson  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  host User @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@map("room_sessions")
}
