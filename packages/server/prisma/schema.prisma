// Local development runs on SQLite so the project needs no Docker.
//
// PORTABILITY: this schema deliberately avoids Prisma features that do not
// exist in SQLite (native enums, scalar lists). Statuses and roles are plain
// strings constrained by TypeScript unions in @soc/shared, and structured blobs
// are JSON-encoded strings. Moving to Postgres on AWS is therefore a change of
// `provider` + DATABASE_URL plus a fresh migration -- not a rewrite.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  /// "student" | "instructor" | "admin" -- see UserRole in @soc/shared
  role         String    @default("student")
  /// "free" | "paid" -- see UserTier in @soc/shared. Free opens the whole
  /// learning platform and the war rooms; paid adds the career pack (the
  /// assessment, the portfolio, the simulation interview).
  tier         String    @default("free")
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// How the floor addresses this person over the microphone. Nullable because
  /// it is chosen when somebody first takes a seat rather than at signup: the
  /// learning platform never needs it, and asking for one during registration
  /// is a question about a product the person has not seen yet.
  /// Set when war room access is suspended, and cleared when it lapses. Null
  /// for almost every account. Deliberately separate from any learning-side
  /// state: conduct in a room never costs somebody their coursework.
  roomsSuspendedUntil DateTime?
  /// Indefinite war room ban, pending a person reading the file. Still not
  /// permanent and still not the learning platform.
  roomsBanned         Boolean   @default(false)

  callSign String? @unique
  /// See AVATARS in @soc/shared. Plain string, not an enum, for Postgres
  /// portability.
  avatarId String?

  progress         ExerciseProgress[]
  practiceProgress PracticeProgress[]
  terminalSessions TerminalSession[]
  attempts         AttemptLog[]
  copilotConsults  CopilotConsult[]
  scenarioAttempts ScenarioAttempt[]
  assessment       AssessmentSession?
  hostedRooms      RoomSession[]
  capstones        CapstoneSubmission[]

  @@map("users")
}

/// One row per student per exercise. Created lazily on first attempt.
model ExerciseProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable content id such as "1.4.3". Not a foreign key: exercise content
  /// lives in version-controlled code, not in the database.
  exerciseId String
  /// Denormalised for cheap per-package aggregate queries.
  packageId  String
  moduleId   String

  /// "not_started" | "in_progress" | "passed" -- see ExerciseStatus
  status          String    @default("in_progress")
  attempts        Int       @default(0)
  completedAt     DateTime?
  lastAttemptedAt DateTime?

  /// How many hints the student has asked for, so the UI can restore the same
  /// state on reload rather than silently re-hiding help they already used.
  hintsRevealed Int @default(0)

  /// Whether the student asked to be shown the answer. Recorded so instructors
  /// can see where the material is too hard -- never used to penalise anyone.
  solutionRevealed Boolean @default(false)

  @@unique([userId, exerciseId])
  @@index([userId, packageId])
  @@map("exercise_progress")
}

/// Progress on optional practice drills.
///
/// Kept separate from ExerciseProgress on purpose: practice must never affect
/// unlocking or the completion percentage, and keeping it in its own table makes
/// that impossible to get wrong by accident.
model PracticeProgress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Parent exercise, e.g. "1.4.3".
  exerciseId String
  /// Drill id, e.g. "1.4.3-p2".
  practiceId String

  passed          Boolean   @default(false)
  attempts        Int       @default(0)
  completedAt     DateTime?
  lastAttemptedAt DateTime?

  @@unique([userId, practiceId])
  @@index([userId, exerciseId])
  @@map("practice_progress")
}

/// Live terminal state for one student working one exercise, so a student can
/// close the browser mid-exercise and pick up exactly where they left off.
model TerminalSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String

  /// Current working directory in the simulated filesystem.
  cwd String @default("/home/student")

  /// JSON-encoded overlay of the student's mutations against the immutable
  /// base filesystem image. Storing only the diff keeps rows small -- the
  /// seeded logs alone are hundreds of kilobytes.
  overlayJson String @default("{}")

  /// JSON-encoded scrollback so the terminal redraws on reload.
  scrollbackJson String @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@map("terminal_sessions")
}

/// Append-only record of every attempt. Required for the instructor audit
/// trail, and it is what tells us which exercises students get stuck on.
model AttemptLog {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  exerciseId String
  /// Set when the attempt was against a practice drill rather than the exercise.
  practiceId String?
  /// Exactly what the student typed.
  input      String
  passed     Boolean
  /// JSON-encoded array of failed check types, for stuck-point analytics.
  failedJson String   @default("[]")
  createdAt  DateTime @default(now())

  @@index([userId, exerciseId])
  @@index([exerciseId, passed])
  @@map("attempt_logs")
}

/// A learner's answers to the Career Fit Analyzer.
///
/// One row per user: retaking replaces answers rather than accumulating history,
/// because a stale answer from three months ago should not quietly keep steering
/// somebody's recommendation. Individual dimensions can be retaken, which is why
/// responses are stored as a keyed blob rather than a fixed set of columns.
model AssessmentSession {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// JSON: { [itemId]: { value?: number, optionId?: string } }
  /// A JSON string rather than a relation table because responses are only ever
  /// read and written as a whole set, and this schema must port to Postgres
  /// without scalar lists.
  responsesJson String @default("{}")

  /// JSON-encoded LearnerProfile: sector, org size, clearance, chosen track.
  profileJson String @default("{}")

  /// The generated report, cached so revisiting results does not rescore.
  /// Null until the learner submits for the first time.
  reportJson String?

  /// JSON: { [probeId]: optionId } for the capability baseline.
  /// Stored on the same row as the career assessment because the two are one
  /// journey -- "what do you want" then "what can you do" -- and separating them
  /// would mean two lookups on every dashboard render.
  probeResponsesJson String @default("{}")

  /// Which lane the baseline was taken against. Readiness is lane-specific: the
  /// same answers mean different things for SOC and for risk work.
  baselineLaneId String?

  /// Set when the learner has seen their report at least once.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("assessment_sessions")
}

/// One row per student per alert they opened the AI copilot on.
///
/// Recorded server-side when the analysis is served, never reported by the
/// client. "Did you consult the copilot before deciding" is graded, so a
/// client-supplied answer to it would be an answer the student controls -- the
/// same reasoning that keeps the terminal and the exercise checks on the server.
///
/// It doubles as the instructor audit trail: what the assistant was asked about,
/// by whom, and how often, which is what a debrief needs in order to say "it
/// suggested X and you found Y".
model CopilotConsult {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The exercise the queue was being worked for. Consultation is scoped to it
  /// so that re-reading an alert while working a later exercise cannot
  /// retroactively satisfy an earlier one's `copilot-consulted` check.
  exerciseId String
  /// Alert the analysis was requested for, e.g. "A-5006".
  alertId    String

  /// How many times it was opened. A student who re-reads one analysis five
  /// times was working at it, and that is worth an instructor seeing.
  views Int @default(1)

  createdAt    DateTime @default(now())
  lastViewedAt DateTime @updatedAt

  @@unique([userId, exerciseId, alertId])
  @@index([userId, exerciseId])
  @@map("copilot_consults")
}

/// The GitHub Lab: a student's self-attested progress on one track's capstone
/// project. Never auto-verified -- see content/capstones.ts for why the server
/// must not reach out and check a student-supplied repo itself.
model CapstoneSubmission {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Not a foreign key: track and option content live in code, same
  /// convention as ExerciseProgress.exerciseId.
  trackId  String
  optionId String

  /// "selected" | "submitted" -- see CapstoneSubmissionStatus in @soc/shared
  status      String    @default("selected")
  repoUrl     String?
  summary     String?
  selectedAt  DateTime  @default(now())
  submittedAt DateTime?

  /// One active capstone per student per track: picking a new option
  /// overwrites the row rather than stacking up abandoned selections.
  @@unique([userId, trackId])
  @@index([userId])
  @@map("capstone_submissions")
}

/// One completed run of one scenario, at one tier, from one seat.
///
/// NOT UNIQUE ON (user, scenario, tier). Repeating is the intended progression:
/// the same incident at a harder tier is the whole point of the difficulty
/// design, and running it again from a different chair is different practice
/// because no seat sees the whole board. Every run is its own row, and the
/// picker derives its badges from the set.
model ScenarioAttempt {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Content id such as "cheap-rent". Not a foreign key: scenarios live in
  /// version-controlled code rather than in the database.
  scenarioId String
  /// "beginner" | "intermediate" | "advanced" | "expert" -- ScenarioDifficulty.
  difficulty String
  /// The seat they held, e.g. "forensics" -- see SocRoleId in @soc/shared.
  role       String

  /// Out of 100, across every event they claimed.
  score          Int
  /// Whether this run reached the findings that decided the incident.
  /// Stored rather than derived because the answer key can be re-authored, and
  /// a student's history should not change when content does.
  caughtCritical Boolean @default(false)

  /// The room this was run in, so an instructor can reach the whole session.
  roomId String?

  completedAt DateTime @default(now())

  @@index([userId, scenarioId])
  @@index([userId, completedAt])
  @@map("scenario_attempts")
}

/// One adversarial match between two students: one attacks (red), one defends
/// (blue), turn for turn and asynchronously. See MatchState in @soc/shared.
///
/// WHY PLAYERS ARE PLAIN IDS, NOT RELATIONS
/// A match references two users but is owned by neither, the same call the
/// schema already makes for ScenarioAttempt.roomId. Storing red/blue/host as
/// bare id strings avoids threading two nullable back-relations through the
/// User model -- which two parallel sessions would both be editing -- and costs
/// only referential cascade, which a walked-away match row does not need.
///
/// WHY ONE JSON BLOB
/// The authoritative board (both sides' full move history and identities) is a
/// single JSON string, never read piecemeal and never sent whole to a client:
/// matchViewFor() redacts it per side. Only the fields the lobby and "my
/// matches" queries filter on are promoted to columns, and those are derived
/// from the blob on every write so they cannot drift from it.
model Match {
  id         String @id @default(uuid())
  scenarioId String
  /// ScenarioDifficulty
  difficulty String
  /// MatchStatus: "waiting" | "active" | "complete" | "abandoned"
  status     String @default("waiting")
  /// RoomVisibility: "open" (queue) | "closed" (invite code)
  visibility String

  /// Set for closed matches, null for open ones. Indexed for join-by-code.
  joinCode String?

  hostUserId String
  redUserId  String?
  blueUserId String?

  /// The full MatchState as JSON: identities, every move, turn cursor, clocks.
  /// Source of truth; the columns above are a queryable projection of it.
  stateJson String @default("{}")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastMoveAt DateTime?

  @@index([joinCode])
  @@index([status, visibility])
  @@index([redUserId])
  @@index([blueUserId])
  @@map("matches")
}

/// A scheduled war room: one scenario, run at one tier, at one start time.
///
/// The seat chart is built from the scenario's own declared roles and never
/// from the role catalogue, so a scenario that seats six has six chairs and a
/// seventh cannot be offered or taken. See the seating tests in
/// services/rooms.test.ts, which hold that for every scenario in the
/// catalogue.
model RoomSession {
  id              String   @id @default(uuid())
  scenarioId      String
  /// "beginner" | "intermediate" | "advanced" | "expert" -- ScenarioDifficulty
  /// in @soc/shared. On the run, not the scenario: the same incident is worth
  /// playing at more than one tier.
  difficulty      String
  startsAt        DateTime
  /// "open" | "closed" -- RoomVisibility in @soc/shared.
  visibility      String
  /// Set for closed rooms and null for open ones. Stored rather than derived so
  /// a leaked code can be rotated without moving everybody to a new room.
  joinCode        String?
  /// "scheduled" | "running" | "complete" | "cancelled" -- RoomStatus.
  status          String   @default("scheduled")
  hostUserId      String
  /// SeatAssignment[] as JSON. Seats are read and written as one unit and are
  /// never queried across rooms, so a table would buy nothing and cost a join
  /// on every seat change.
  seatsJson       String
  /// LeadReadout as JSON, written once when the lead closes the shift. Null
  /// until then. Stored rather than rebuilt because it is what the lead said
  /// BEFORE seeing the answer key, and the whole value of the review is
  /// comparing those two things.
  readoutJson     String?
  /// Seconds after startsAt that the lead closed it. Held explicitly rather
  /// than derived from updatedAt, which moves every time a seat changes.
  closedAtSeconds Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  host User @relation(fields: [hostUserId], references: [id], onDelete: Cascade)

  @@index([status, startsAt])
  @@map("room_sessions")
}

/// One seat's claim on one event during a live shift.
///
/// WHY ONE PER (ROOM, EVENT, ROLE) AND IMMUTABLE
///
/// A claim is scored against how long the seat took and what they said, and a
/// row that could be silently rewritten would let a late or wrong claim be
/// quietly corrected after the fact -- the same reason a terminal session
/// cannot be edited after the check runs. Two different seats may still claim
/// one event two different ways; see `contestedEvents` in services/scenarios.ts,
/// which is what that disagreement is for.
///
/// Plain string ids rather than relations, same reasoning as `CommunityEvent`:
/// this is scoped to one room's shift and is never queried across rooms.
model RoomClaim {
  id      String @id @default(uuid())
  roomId  String
  eventId String
  /// SocRoleId. The seat this claim was made from, not necessarily the
  /// event's rightful first responder -- that is what scoring checks.
  role    String
  userId  String

  /// TriageDecision -- "escalate" | "investigate" | "dismiss" | "tune".
  disposition   String
  reasoning     String
  /// string[] as JSON -- ScenarioAction ids chosen for this claim.
  actionIdsJson String
  /// SocRoleId, or null to mean "stops here".
  escalateTo    String?
  /// 0 to 100.
  confidence    Int
  /// Seconds after the room's startsAt that this claim was committed. Scoring
  /// reads this against the event's own atSeconds for the timing line.
  atSeconds     Int

  createdAt DateTime @default(now())

  @@unique([roomId, eventId, role])
  @@index([roomId])
  @@map("room_claims")
}

/// A badge somebody has earned.
///
/// WHY THIS IS A ROW AND NOT A QUERY
///
/// Badge requirements grow: a package written next month becomes part of a
/// track badge somebody already holds. Derived badges would quietly vanish from
/// their case when that happens, which is the same failure the platform refuses
/// everywhere else -- nothing may downgrade a pass. The award is written once
/// and never recomputed, so what somebody earned stays earned.
///
/// The badge id is content, not a foreign key, for the same reason exercise ids
/// are: the catalogue lives in version-controlled code.
model EarnedBadge {
  id      String @id @default(uuid())
  userId  String
  badgeId String

  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("earned_badges")
}

/// A public chat room off the lobby.
///
/// ALWAYS PUBLIC. There is no visibility column and no join code here on
/// purpose: see the note in @soc/shared/lobby.ts. Anything scoped and private
/// is a war room, which ends.
///
/// Core rooms are seeded and cannot be reviewed or closed. Community rooms are
/// requested by a student, sit in `pending`, and become real only when a
/// reviewer approves them.
model ChatRoom {
  /// Slug. Permanent: messages reference it.
  id    String @id
  title String
  /// What the room is for, in the requester's own words. Required, including
  /// for core rooms: a list of bare names makes everybody guess, and the guess
  /// is what fills a lobby with six rooms for the same idea.
  topic String

  /// "core" | "community" -- ChatRoomKind in @soc/shared.
  kind   String @default("community")
  /// "pending" | "approved" | "rejected" | "closed" -- ChatRoomStatus.
  status String @default("pending")

  /// Null for core rooms, which nobody requested. Plain ids rather than
  /// relations, following the Match precedent: no back-relations threaded
  /// through User, which parallel sessions are usually editing.
  requestedByUserId String?
  /// The requester's floor identity, captured at request time so a rename does
  /// not rewrite the review queue.
  requestedCallSign String?
  requestedAvatarId String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  /// Shown to the requester. A refusal without a reason is not a decision, it
  /// is a disappearance.
  reviewNote       String?

  createdAt DateTime @default(now())

  messages ChatMessage[]

  @@index([status])
  @@map("chat_rooms")
}

/// One line said in one room.
///
/// The author's call sign and avatar are DENORMALISED onto the row. A
/// transcript that rewrites itself when somebody renames is a transcript nobody
/// can follow, and joining to the live identity would do exactly that.
model ChatMessage {
  id     String   @id @default(uuid())
  roomId String
  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  userId   String
  callSign String
  avatarId String

  body    String
  /// Set when an event was shared into the room, so the client draws the card
  /// rather than a line of text. A plain id: the event may be cancelled later
  /// and the message still happened.
  eventId String?

  /// Hidden by a reviewer rather than deleted, so moderation is auditable and
  /// a mistake is reversible. Hidden rows never leave the server.
  hidden Boolean  @default(false)
  sentAt DateTime @default(now())

  @@index([roomId, sentAt])
  @@map("chat_messages")
}

/// Who is standing in the lobby right now.
///
/// Presence is a heartbeat, not a connection: one row per person, overwritten
/// every twenty seconds, and treated as gone after seventy-five. A socket would
/// be more accurate and would cost connection state, reconnect logic and a
/// deployment story this product does not have yet.
model LobbyPresence {
  userId String @id

  callSign String
  avatarId String

  /// Which war room door they say they are heading for, or null. Drives the
  /// "three people waiting for a SOC room" count that is the whole reason the
  /// lobby exists.
  headingFor String?

  /// When they walked in. Distinct from lastSeenAt: the arrival is what the
  /// room animates, and a heartbeat must not restart it.
  arrivedAt  DateTime @default(now())
  lastSeenAt DateTime @updatedAt

  @@index([lastSeenAt])
  @@map("lobby_presence")
}

/// Something somebody scheduled for other people.
///
/// Deliberately NOT a war room: most of what a group of career changers wants
/// to arrange has no seats, no scenario and no grader. An event can point at a
/// war room with `roomId` when that is what it is for.
///
/// There is no URL field, and that is a decision. A user-posted link in a feed
/// strangers read is the exact thing this platform teaches people to distrust.
model CommunityEvent {
  id          String @id @default(uuid())
  title       String
  description String
  /// EventKind in @soc/shared.
  kind        String
  /// LobbyDoorId or "all" -- EventAudience.
  audience    String @default("all")

  startsAt        DateTime
  durationMinutes Int

  hostUserId   String
  hostCallSign String
  hostAvatarId String

  /// The war room this is for, when it is for one. A plain id: an event
  /// outlives the room it pointed at, and a cascade that deleted somebody's
  /// calendar entry because a room was cancelled would be worse than a dangling
  /// reference the client renders as "that room is gone".
  roomId String?

  /// Null means no limit, which is the common case.
  capacity Int?

  /// A cancelled event stays visible and struck through rather than vanishing.
  /// People planned around it, and silence is the worst way to tell them.
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  rsvps EventRsvp[]

  @@index([startsAt])
  @@map("community_events")
}

/// One person's answer to one event.
///
/// "interested" exists so capacity does not throw away the signal: somebody
/// marking interest in a full session is how a host learns to run a second one.
model EventRsvp {
  id      String         @id @default(uuid())
  eventId String
  event   CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  /// "going" | "interested" -- RsvpStatus in @soc/shared.
  status String

  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_rsvps")
}

/// One person reporting one other person in one shared room.
///
/// WHY THE UNIQUE KEY IS (ROOM, REPORTER, SUBJECT)
///
/// The threshold counts distinct reporters, so the database has to be the
/// thing that makes a second click from the same person a no-op. Enforcing it
/// in the service instead would leave two simultaneous posts both counting,
/// which is exactly the case somebody trying to abuse this would find.
///
/// Plain string ids rather than relations to the room, because the room may be
/// a SOC floor session, a red versus blue match or a chat room, and those are
/// three different tables. `space` says which.
model ConductReport {
  id             String @id @default(uuid())
  /// ReportSpace in @soc/shared.
  space          String
  roomId         String
  reporterUserId String
  subjectUserId  String
  /// ReportReasonId in @soc/shared.
  reason         String
  note           String @default("")
  /// ReportContext as JSON, captured by the server at the moment the button
  /// was pressed. See the type for why it is stored rather than looked up.
  contextJson    String

  /// "open" | "upheld" | "dismissed" -- ReportOutcome. Automatic ejection
  /// never writes this: a room being made usable is not a finding about a
  /// person, and only a reviewer decides that.
  outcome          String    @default("open")
  reviewedByUserId String?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  @@unique([roomId, reporterUserId, subjectUserId])
  @@index([subjectUserId, createdAt])
  @@index([outcome, createdAt])
  @@map("conduct_reports")
}

/// Somebody removed from one room by the threshold.
///
/// Kept as its own row rather than inferred by re-counting reports, for two
/// reasons. It is what stops them rejoining the room they were removed from,
/// which has to be a cheap lookup on every seat request. And it is the unit
/// account-level action counts, so it must not move when a reviewer later
/// dismisses one report out of four.
model RoomEjection {
  id        String  @id @default(uuid())
  /// ReportSpace in @soc/shared.
  space     String
  roomId    String
  userId    String
  /// The reason id that carried the most reports, for the queue to sort by.
  reason    String
  /// How many distinct people had reported them when this fired.
  reporters Int
  /// True once a reviewer has set this aside, which restores the account
  /// count without rewriting history.
  reversed  Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId, createdAt])
  @@map("room_ejections")
}
