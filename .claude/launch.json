{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "soc-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:client"
      ],
      "port": 5173
    },
    {
      "name": "soc-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 4000
    },
    {
      "name": "soc-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "@soc/client"
      ],
      "autoPort": true
    }
  ]
}
